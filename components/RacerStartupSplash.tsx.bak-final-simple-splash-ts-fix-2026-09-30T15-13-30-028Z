function racerInstallFinalMobileFit(){
  if(typeof document==="undefined") return;
  document.documentElement.style.width="100%";
  document.documentElement.style.maxWidth="100%";
  document.body.style.width="100%";
  document.body.style.maxWidth="100%";
  document.body.style.margin="0";
  document.body.style.padding="0";
  document.body.style.overflowX="hidden";

  const styleId="racer-final-mobile-fit-style";
  if(!document.getElementById(styleId)){
    const style=document.createElement("style");
    style.id=styleId;
    style.textContent=`
      html,body{width:100%!important;max-width:100%!important;margin:0!important;padding:0!important;overflow-x:hidden!important}
      body.racer-final-login-fit{min-height:100dvh!important}
      body.racer-final-login-fit main,
      body.racer-final-login-fit [role="main"]{
        width:100vw!important;max-width:100vw!important;min-height:100dvh!important;box-sizing:border-box!important;margin:0!important;
      }
      @media(max-width:700px){
        body.racer-final-login-fit main,
        body.racer-final-login-fit [role="main"],
        body.racer-final-login-fit main>div:first-child,
        body.racer-final-login-fit [role="main"]>div:first-child{
          width:100vw!important;max-width:100vw!important;min-height:100dvh!important;box-sizing:border-box!important;margin:0!important;
        }
      }
    `;
    document.head.appendChild(style);
  }

  document.body.classList.add("racer-final-login-fit");

  const textMatches=(el)=>{
    const t=(el.textContent||"").replace(/\\s+/g," ").trim();
    return t.includes("Student") && t.includes("Teacher");
  };

  const elements=Array.from(document.body.querySelectorAll("main,section,div"));
  let best=null;
  let bestScore=-1;

  for(const el of elements){
    if(el.classList.contains("racer-final-splash")) continue;
    if(!textMatches(el)) continue;
    const r=el.getBoundingClientRect();
    if(r.width<120 || r.height<120) continue;
    const score=Math.min(r.width,window.innerWidth)*Math.min(r.height,window.innerHeight);
    if(score>bestScore){
      best=el;
      bestScore=score;
    }
  }

  if(best){
    let root=best;
    for(let i=0;i<4;i++){
      const p=root.parentElement;
      if(!p || p===document.body) break;
      const pr=p.getBoundingClientRect();
      if(pr.width<=window.innerWidth*1.02) root=p;
      if(p.tagName==="MAIN") break;
    }
    root.style.width="100vw";
    root.style.maxWidth="100vw";
    root.style.minHeight="100dvh";
    root.style.margin="0";
    root.style.boxSizing="border-box";
  }
}

export default function RacerStartupSplash(props: Record<string, unknown> = {}){
  const [progress,setProgress]=React.useState(0);
  const [done,setDone]=React.useState(false);

  React.useEffect(()=>{
    const started=performance.now();
    let raf=0;

    const complete=()=>{
      try{
        racerInstallFinalMobileFit();
        const fn =
          (props as any).onComplete ||
          (props as any).onDone ||
          (props as any).onFinish ||
          (props as any).onFinished;
        if(typeof fn==="function") fn();
        window.dispatchEvent(new CustomEvent("racer-splash-complete"));
      }finally{
        setDone(true);
        window.setTimeout(racerInstallFinalMobileFit,180);
        window.setTimeout(racerInstallFinalMobileFit,650);
      }
    };

    const tick=(now)=>{
      const p=Math.min(1,(now-started)/5000);
      setProgress(p*100);
      if(p<1) raf=requestAnimationFrame(tick);
      else complete();
    };

    racerInstallFinalMobileFit();
    raf=requestAnimationFrame(tick);

    return ()=>cancelAnimationFrame(raf);
  },[]);

  if(done) return null;

  return (
    <div className="racer-final-splash" aria-label="RACER ACADEMY loading">
      <style dangerouslySetInnerHTML={{__html:_racerFinalSplashStyles}} />
      <img
        className="racer-final-splash__image"
        src="/racer-simple-splash-final.png"
        alt="RACER ACADEMY"
        draggable={false}
      />
      <div className="racer-final-splash__light" />
      <div className="racer-final-splash__cover" />
      <div className="racer-final-splash__loading">
        <div className="racer-final-splash__track">
          <div
            className="racer-final-splash__fill"
            style={{width: `${progress}%`}}
          />
        </div>
        <div>Loading...</div>
      </div>
    </div>
  );
}
