    case "payments":
      return <svg {...common}><rect x="3" y="6" width="18" height="13" rx="2" /><path d="M3 10h18M7 15h4" /></svg>;
    case "homework":
      return <svg {...common}><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 0-3 3z" /><path d="M8 4v16M11 8h5M11 12h5M11 16h4" /></svg>;
    case "announcement":
