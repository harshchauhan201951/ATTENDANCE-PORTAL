/* Teacher dashboard visual skin */
.racer-teacher-dashboard {
  min-height: 100dvh;
  padding: 0 10px 86px;
  background: #f4f7fb;
  color: #172033;
  font-family: Arial, Helvetica, sans-serif;
}

.racer-teacher-inner {
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
}

.racer-teacher-header {
  min-height: 68px;
  margin: 0 -10px 12px;
  padding: 10px 13px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: linear-gradient(180deg,#0d58a7,#0b4f96);
  color: #fff;
  box-shadow: 0 2px 10px rgba(15,55,100,.18);
}

.racer-teacher-brand { display:flex; align-items:center; gap:9px; min-width:0; }
.racer-teacher-logo { width:36px; height:36px; border-radius:50%; display:grid; place-items:center; flex:0 0 36px; background:#fff; color:#0b58a5; font-size:12px; font-weight:950; }
.racer-teacher-kicker { font-size:7px; letter-spacing:1.15px; opacity:.78; }
.racer-teacher-header h1 { margin:2px 0 0; font-size:16px; line-height:1.15; font-weight:850; }
.racer-teacher-header p { margin:2px 0 0; font-size:8px; opacity:.78; }
.racer-teacher-header-actions { display:flex; align-items:center; gap:6px; }
.racer-teacher-header-actions button { border:0; cursor:pointer; }
.racer-teacher-header-actions > button:first-child { width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,.12); color:#fff; }
.racer-teacher-logout { padding:8px 10px; border-radius:8px; background:#fff; color:#0b58a5; font-size:8px; font-weight:800; }

.racer-teacher-title { display:flex; align-items:flex-end; justify-content:space-between; gap:10px; margin:12px 1px 8px; }
.racer-teacher-title span { display:block; color:#7a8799; font-size:7px; font-weight:800; letter-spacing:1.2px; }
.racer-teacher-title h2 { margin:2px 0 0; font-size:20px; line-height:1.1; }
.racer-teacher-title strong { padding:6px 7px; border-radius:7px; background:#e7f1fc; color:#0b58a5; font-size:7px; white-space:nowrap; }

.racer-teacher-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:7px; }
.racer-teacher-module { position:relative; min-width:0; min-height:94px; padding:9px 6px 8px; border:1px solid #e0e8f1; border-radius:9px; background:#fff; color:#172033; box-shadow:0 2px 8px rgba(22,50,80,.055); cursor:pointer; text-align:center; transition:transform .15s ease, box-shadow .15s ease; }
.racer-teacher-module:hover { transform:translateY(-2px); box-shadow:0 6px 16px rgba(22,50,80,.1); }
.racer-teacher-module-icon { width:34px; height:34px; margin:0 auto 7px; display:grid; place-items:center; border-radius:10px; background:#eaf3fd; color:#0b58a5; font-size:17px; font-weight:850; }
.racer-teacher-module-title { display:block; font-size:8.5px; line-height:1.2; font-weight:800; }
