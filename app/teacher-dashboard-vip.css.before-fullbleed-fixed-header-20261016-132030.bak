/* =====================================================================
   RACER ACADEMY - TEACHER DASHBOARD "VIP" (mobile-first app design)
   Theme badalne ke liye teacher/dashboard/page.tsx me VIP_THEME = "gold" | "royal"
   ===================================================================== */
.vip-td {
  --gold: #f5c542; --gold-2: #ffe29a;
  min-height: 100dvh; padding-bottom: calc(92px + env(safe-area-inset-bottom));
  background: var(--bg); color: var(--ink);
  font-family: Inter, "Plus Jakarta Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  -webkit-font-smoothing: antialiased; overflow-x: hidden;
}
.vip-td *, .vip-td *::before, .vip-td *::after { box-sizing: border-box; }
:where(.vip-td) button { font: inherit; color: inherit; border: 0; background: none; padding: 0; cursor: pointer; text-align: inherit; -webkit-tap-highlight-color: transparent; }
:where(.vip-td) :is(h1, h2, p) { margin: 0; }

/* ---------- themes ---------- */
.vip-td--gold {
  --bg: radial-gradient(120% 60% at 90% -10%, #1b2f73 0%, transparent 60%), linear-gradient(180deg, #070f26 0%, #0a1634 55%, #060c1d 100%);
  --ink: #f3f6ff; --mute: #9db0d8; --accent: var(--gold);
  --card: linear-gradient(160deg, rgba(255,255,255,.085), rgba(255,255,255,.03));
  --line: rgba(255, 214, 125, .2); --shadow: 0 10px 28px rgba(0,0,0,.35);
  --hero: linear-gradient(135deg, #1a3a8f 0%, #0f2259 48%, #0a1738 100%);
  --hero-line: rgba(255, 214, 125, .45); --chip-bg: rgba(245,197,66,.16); --chip-ink: var(--gold-2);
  --btn-bg: rgba(255,255,255,.08);
}
.vip-td--royal {
  --bg: linear-gradient(180deg, #1d3bdf 0, #2f5bff 150px, #eef3ff 150px);
  --ink: #0f1f46; --mute: #62729b; --accent: #2f5bff;
  --card: #fff; --line: #e0e8fb; --shadow: 0 8px 22px rgba(30, 60, 160, .10);
  --hero: linear-gradient(135deg, #ffffff, #f2f6ff);
  --hero-line: #dbe5ff; --chip-bg: #e9e8ff; --chip-ink: #5a46d6;
  --btn-bg: rgba(255,255,255,.18);
}

.vip-td-wrap { width: 100%; max-width: 520px; margin: 0 auto; padding: calc(env(safe-area-inset-top) + 10px) 14px 0; }

/* ---------- top bar ---------- */
.vip-td-top { display: flex; align-items: center; justify-content: space-between; height: 52px; }
.vip-td-brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
.vip-td-logo { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; font-weight: 900; font-size: 14px; letter-spacing: .5px; color: #0a1634; background: linear-gradient(135deg, var(--gold-2), var(--gold)); box-shadow: 0 4px 14px rgba(245,197,66,.35); }
.vip-td-brand strong { display: block; font-size: 14px; letter-spacing: .6px; line-height: 1.1; color: #fff; }
.vip-td--gold .vip-td-brand small { color: var(--gold-2); }
.vip-td-brand small { display: block; margin-top: 2px; font-size: 8.5px; font-weight: 700; letter-spacing: 1.4px; color: rgba(255,255,255,.78); }
.vip-td-actions { display: flex; gap: 8px; }
.vip-td-icon-btn { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; color: #fff; background: var(--btn-bg); border: 1px solid rgba(255,255,255,.16) !important; backdrop-filter: blur(8px); }
.vip-td-icon-btn:active { transform: scale(.94); }

/* ---------- hero ---------- */
.vip-td-hero { position: relative; margin-top: 14px; padding: 16px; border-radius: 24px; overflow: hidden; background: var(--hero); border: 1px solid var(--hero-line); box-shadow: var(--shadow); }
.vip-td--gold .vip-td-hero::before { content: ""; position: absolute; right: -70px; top: -70px; width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(circle, rgba(245,197,66,.35), transparent 65%); }
.vip-td--gold .vip-td-hero::after { content: ""; position: absolute; right: -40px; top: -40px; width: 160px; height: 160px; border-radius: 50%; border: 1px solid rgba(255,214,125,.25); box-shadow: 0 0 0 22px rgba(255,214,125,.05), 0 0 0 44px rgba(255,214,125,.035); pointer-events: none; }
.vip-td-hero > * { position: relative; z-index: 1; }
.vip-td-id { display: flex; align-items: center; gap: 12px; }
.vip-td-avatar { position: relative; width: 58px; height: 58px; flex: none; border-radius: 50%; display: grid; place-items: center; overflow: visible; font-size: 22px; font-weight: 800; color: #0a1634; background: linear-gradient(135deg, var(--gold-2), var(--gold)); padding: 3px !important; box-shadow: 0 0 0 3px rgba(245,197,66,.28); }
.vip-td--royal .vip-td-avatar { background: linear-gradient(135deg, #5b7cff, #2f5bff); color: #fff; box-shadow: 0 0 0 3px #dbe5ff; }
.vip-td-avatar img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; }
.vip-td-avatar i { position: absolute; right: 1px; bottom: 1px; width: 13px; height: 13px; border-radius: 50%; background: #29df68; border: 2px solid #0f2259; }
.vip-td--royal .vip-td-avatar i { border-color: #fff; }
.vip-td-id small { font-size: 12px; color: var(--mute); }
.vip-td-id h1 { margin-top: 1px; font-size: 21px; line-height: 1.15; font-weight: 800; letter-spacing: .2px; overflow-wrap: anywhere; }
.vip-td-chip { display: inline-block; margin-top: 6px; padding: 4px 10px; border-radius: 999px; font-size: 9.5px; font-weight: 800; letter-spacing: 1.2px; background: var(--chip-bg); color: var(--chip-ink); }

.vip-td-stats { display: grid; grid-template-columns: 1.15fr 1fr; gap: 10px; margin-top: 14px; }
.vip-td-total { padding: 12px 14px; border-radius: 18px; background: rgba(255,255,255,.07); border: 1px solid var(--hero-line); }
.vip-td--royal .vip-td-total { background: #eef3ff; }
.vip-td-total small { font-size: 11px; color: var(--mute); }
.vip-td-total strong { display: block; margin: 2px 0; font-size: 38px; line-height: 1; font-weight: 900; color: var(--gold-2); }
.vip-td--royal .vip-td-total strong { color: #2f5bff; }
.vip-td-total span { font-size: 10.5px; color: var(--mute); }
.vip-td-mini { display: grid; gap: 6px; }
.vip-td-mini div { display: flex; align-items: center; gap: 7px; padding: 6px 10px; border-radius: 12px; background: rgba(255,255,255,.06); font-size: 11px; }
.vip-td--royal .vip-td-mini div { background: #f3f6ff; }
.vip-td-mini svg { color: var(--accent); flex: none; }
.vip-td-mini small { color: var(--mute); font-size: 10px; }
.vip-td-mini b { margin-left: auto; font-size: 12px; font-weight: 800; white-space: nowrap; }

/* ---------- quick actions ---------- */
.vip-td-quick { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 14px; }
.vip-td-q { display: flex; flex-direction: column; align-items: center; gap: 7px; padding: 12px 2px 10px; border-radius: 18px; background: var(--card); border: 1px solid var(--line) !important; box-shadow: var(--shadow); text-align: center !important; font-size: 9.8px; letter-spacing: -.1px; font-weight: 700; line-height: 1.2; }
.vip-td-q:active, .vip-td-tile:active { transform: scale(.96); }
.vip-td-q > span:last-child { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 25px; }

/* ---------- module groups ---------- */
.vip-td-group { margin-top: 20px; }
.vip-td-group-head { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4px 10px; }
.vip-td-group-head h2 { font-size: 15px; font-weight: 800; letter-spacing: .3px; display: flex; align-items: center; gap: 8px; }
.vip-td-group-head h2::before { content: ""; width: 4px; height: 16px; border-radius: 4px; background: var(--accent); }
.vip-td-group-head span { font-size: 11px; color: var(--mute); }
.vip-td-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.vip-td-grid[data-n="2"] { grid-template-columns: repeat(2, 1fr); }
.vip-td-tile { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; min-height: 106px; padding: 14px 6px 12px; border-radius: 20px; background: var(--card); border: 1px solid var(--line) !important; box-shadow: var(--shadow); text-align: center !important; transition: transform .12s; }
.vip-td-grid[data-n="2"] .vip-td-tile { flex-direction: row; justify-content: flex-start; min-height: 74px; padding: 12px 14px; gap: 12px; text-align: left !important; }
.vip-td-tile-title { font-size: 11.5px; font-weight: 700; line-height: 1.22; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.vip-td-grid[data-n="2"] .vip-td-tile-title { font-size: 13.5px; }
.vip-td-tile-ico, .vip-td-q-ico { width: 46px; height: 46px; flex: none; border-radius: 15px; display: grid; place-items: center; color: #fff; background: var(--tone); box-shadow: 0 6px 14px var(--tone-glow), inset 0 1px 0 rgba(255,255,255,.35); }
.vip-td-q-ico { width: 42px; height: 42px; border-radius: 14px; }
[data-tone="blue"]   { --tone: linear-gradient(135deg,#4f8cff,#1d4ed8); --tone-glow: rgba(59,130,246,.4); }
[data-tone="violet"] { --tone: linear-gradient(135deg,#a78bfa,#6d28d9); --tone-glow: rgba(139,92,246,.4); }
[data-tone="green"]  { --tone: linear-gradient(135deg,#34d399,#047857); --tone-glow: rgba(16,185,129,.4); }
[data-tone="orange"] { --tone: linear-gradient(135deg,#fbbf24,#d97706); --tone-glow: rgba(245,158,11,.4); }
[data-tone="pink"]   { --tone: linear-gradient(135deg,#f472b6,#be185d); --tone-glow: rgba(236,72,153,.4); }
[data-tone="cyan"]   { --tone: linear-gradient(135deg,#22d3ee,#0e7490); --tone-glow: rgba(6,182,212,.4); }

/* ---------- footer banner ---------- */
.vip-td-banner { display: flex; align-items: center; gap: 12px; margin-top: 22px; padding: 14px; border-radius: 20px; background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow); }
.vip-td-banner > span:first-child { width: 40px; height: 40px; flex: none; border-radius: 13px; display: grid; place-items: center; color: #0a1634; background: linear-gradient(135deg, var(--gold-2), var(--gold)); }
.vip-td-banner strong { display: block; font-size: 13px; }
.vip-td-banner small { font-size: 11px; color: var(--mute); }

/* ---------- bottom nav ko VIP dark theme ke saath milana ---------- */
.racer-teacher-shell:has(.vip-td--gold) .racer-bottom-nav { background: rgba(8, 16, 40, .94) !important; border-top: 1px solid rgba(255, 214, 125, .22) !important; backdrop-filter: blur(14px); }
.racer-teacher-shell:has(.vip-td--gold) .racer-bottom-nav-item { color: #8ea2cc !important; }
.racer-teacher-shell:has(.vip-td--gold) .racer-bottom-nav-item.active { color: var(--gold-2, #ffe29a) !important; }
.racer-teacher-shell:has(.vip-td--gold) .racer-bottom-nav-item.active .racer-bottom-nav-icon { background: rgba(245, 197, 66, .18) !important; color: #ffe29a !important; }

/* ---------- tablet / laptop / Windows ---------- */
@media (min-width: 700px) {
  .vip-td-wrap { max-width: 760px; }
  .vip-td-grid { grid-template-columns: repeat(4, 1fr); }
  .vip-td-grid[data-n="2"] { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1025px) {
  .vip-td { padding-bottom: 40px; }
  .vip-td--royal { --bg: #eef3ff; }
  .vip-td-wrap { max-width: 1240px; padding: 28px 32px 0; }
  .vip-td-top { display: none; }
  .vip-td-hero { margin-top: 0; padding: 24px 28px; display: grid; grid-template-columns: 1fr 1.3fr; align-items: center; gap: 24px; }
  .vip-td-stats { margin-top: 0; }
  .vip-td-quick { grid-template-columns: repeat(4, minmax(0, 260px)); }
  .vip-td-q { flex-direction: row; justify-content: flex-start; gap: 12px; padding: 14px 16px; font-size: 13px; text-align: left !important; }
  .vip-td-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .vip-td-grid[data-n="2"] { grid-template-columns: repeat(2, minmax(0, 260px)); }
  .vip-td-tile { min-height: 120px; }
  .vip-td-tile-title { font-size: 13px; }
}
