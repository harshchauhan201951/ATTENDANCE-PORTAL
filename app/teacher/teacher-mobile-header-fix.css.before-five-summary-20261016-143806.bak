  position: relative !important;
  top: auto !important;
  bottom: auto !important;
  transform: none !important;
  justify-content: flex-start !important;
  align-content: start !important;
  align-items: stretch !important;
}
.racer-teacher-profile-route main > :first-child {
  margin-top: 0 !important;
  padding-top: 0 !important;
  position: relative !important;
  top: auto !important;
  transform: none !important;
}
.racer-teacher-profile-route main > :first-child > :first-child {
  margin-top: 0 !important;
}
@media (max-width: 767px) {
  .racer-portal-content.racer-shared-teacher-module-content.racer-teacher-profile-route {
    padding-top: 172px !important;
  }
  body:has(.racer-teacher-profile-route) .racer-teacher-profile-route main {
    margin-top: 36px !important;
  }
}
/* RACER PROFILE TOP-SPACE FIX END */
/* RACER PROFILE TOP GAP FINAL FIX */
.racer-portal-content.racer-shared-teacher-module-content.racer-teacher-profile-route {
  margin-top: 0 !important;
  min-height: 0 !important;
  height: auto !important;
