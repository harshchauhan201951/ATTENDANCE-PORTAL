import { NextRequest, NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

const supabaseAdmin =
  supabaseUrl && serviceRoleKey
    ? createClient(
        supabaseUrl,
        serviceRoleKey,
        {
          auth: {
            autoRefreshToken: false,
            persistSession: false,
          },
        }
      )
    : null;

function positiveInt(value: unknown): number | null {
  const numberValue = Number(value);

  if (
    !Number.isInteger(numberValue) ||
    numberValue <= 0
  ) {
    return null;
  }

  return numberValue;
}

async function verifyTeacher(
  teacherIdValue: unknown
) {
  const teacherId = positiveInt(teacherIdValue);

  if (!teacherId) {
    return {
      ok: false,
      error: "Teacher ID is missing or invalid.",
    } as const;
  }

  if (!supabaseAdmin) {
    return {
      ok: false,
      error: "Supabase service configuration is missing.",
    } as const;
  }

  const { data, error } = await supabaseAdmin
    .from("teachers")
    .select("id")
    .eq("id", teacherId)
    .maybeSingle();

  if (error) {
    return {
      ok: false,
      error: error.message,
    } as const;
  }

  if (!data) {
    return {
      ok: false,
      error: "Teacher account was not found.",
    } as const;
  }

  return {
    ok: true,
    teacherId,
  } as const;
}

async function nextAttemptNumber(
  quizId: number,
  studentId: number
) {
  if (!supabaseAdmin) return 1;

  const { data } = await supabaseAdmin
    .from("quiz_results")
    .select("attempt_number")
    .eq("quiz_id", quizId)
    .eq("student_id", studentId)
    .order("attempt_number", {
      ascending: false,
    })
    .limit(1)
    .maybeSingle();

  return Math.max(
    1,
    Number(data?.attempt_number || 0) + 1
  );
}

export async function GET(request: NextRequest) {
  try {
    if (!supabaseAdmin) {
      return NextResponse.json(
        {
          success: false,
          error: "Supabase service configuration is missing.",
        },
        { status: 500 }
      );
    }

    const searchParams =
      request.nextUrl.searchParams;

    const studentId = positiveInt(
      searchParams.get("studentId")
    );

    const quizIdValue =
      searchParams.get("quizId");

    const quizId = quizIdValue
      ? positiveInt(quizIdValue)
      : null;

    if (!studentId) {
      return NextResponse.json(
        {
          success: false,
          error: "Student ID is missing or invalid.",
        },
        { status: 400 }
      );
    }

    let query = supabaseAdmin
      .from("quiz_reattempt_permissions")
      .select(
        "id,quiz_id,student_id,allowed,used_at,created_at"
      )
      .eq("student_id", studentId)
      .eq("allowed", true)
      .is("used_at", null)
      .order("created_at", {
        ascending: false,
      });

    if (quizId) {
      query = query.eq("quiz_id", quizId);
    }

    const { data, error } = await query;

    if (error) {
      return NextResponse.json(
        {
          success: false,
          error: error.message,
        },
        { status: 500 }
      );
    }

    const permissions = data || [];

    const quizIds = Array.from(
      new Set(
        permissions
          .map((row) => Number(row.quiz_id))
          .filter(
            (id) =>
              Number.isInteger(id) && id > 0
          )
      )
    );

    if (quizId) {
      return NextResponse.json({
        success: true,
        allowed: quizIds.includes(quizId),
        permission:
          permissions.length > 0
            ? permissions[0]
            : null,
        quizIds,
      });
    }

    return NextResponse.json({
      success: true,
      quizIds,
      permissions,
    });
  } catch (error) {
    return NextResponse.json(
      {
        success: false,
        error:
          error instanceof Error
            ? error.message
            : "Unable to load re-attempt permissions.",
      },
      { status: 500 }
    );
  }
}

export async function POST(request: NextRequest) {
  try {
    if (!supabaseAdmin) {
      return NextResponse.json(
        {
          success: false,
          error: "Supabase service configuration is missing.",
        },
        { status: 500 }
      );
    }

    const body = await request.json();
    const action = String(body?.action || "").trim();

    const teacherCheck =
      await verifyTeacher(body?.teacherId);

    if (!teacherCheck.ok) {
      return NextResponse.json(
        {
          success: false,
          error: teacherCheck.error,
        },
        { status: 403 }
      );
    }

    if (action === "allow") {
      const quizId = positiveInt(body?.quizId);
      const studentId = positiveInt(body?.studentId);

      if (!quizId || !studentId) {
        return NextResponse.json(
          {
            success: false,
            error: "Quiz ID and student ID are required.",
          },
          { status: 400 }
        );
      }

      const { data: existing, error: existingError } =
        await supabaseAdmin
          .from("quiz_reattempt_permissions")
          .select(
            "id,quiz_id,student_id,allowed,used_at,created_at"
          )
          .eq("quiz_id", quizId)
          .eq("student_id", studentId)
          .order("created_at", {
            ascending: false,
          })
          .limit(1)
          .maybeSingle();

      if (existingError) {
        return NextResponse.json(
          {
            success: false,
            error: existingError.message,
          },
          { status: 500 }
        );
      }

      const nextAttempt =
        await nextAttemptNumber(
          quizId,
          studentId
        );

      if (existing) {
        if (
          existing.allowed === true &&
          !existing.used_at
        ) {
          return NextResponse.json({
            success: true,
            alreadyAllowed: true,
            permissionId: existing.id,
            attemptNumber: nextAttempt,
            message:
              "Re-attempt access is already allowed for this student.",
          });
        }

        const { data: updated, error: updateError } =
          await supabaseAdmin
            .from("quiz_reattempt_permissions")
            .update({
              allowed: true,
              used_at: null,
            })
            .eq("id", existing.id)
            .select(
              "id,quiz_id,student_id,allowed,used_at,created_at"
            )
            .single();

        if (updateError) {
          return NextResponse.json(
            {
              success: false,
              error: updateError.message,
            },
            { status: 500 }
          );
        }

        return NextResponse.json({
          success: true,
          alreadyAllowed: false,
          permissionId: updated?.id ?? existing.id,
          attemptNumber: nextAttempt,
          message:
            "Re-attempt access allowed successfully.",
        });
      }

      const { data: inserted, error: insertError } =
        await supabaseAdmin
          .from("quiz_reattempt_permissions")
          .insert({
            quiz_id: quizId,
            student_id: studentId,
            allowed: true,
            used_at: null,
          })
          .select(
            "id,quiz_id,student_id,allowed,used_at,created_at"
          )
          .single();

      if (insertError) {
        return NextResponse.json(
          {
            success: false,
            error: insertError.message,
          },
          { status: 500 }
        );
      }

      return NextResponse.json({
        success: true,
        alreadyAllowed: false,
        permissionId: inserted?.id ?? null,
        attemptNumber: nextAttempt,
        message:
          "Re-attempt access allowed successfully.",
      });
    }

    if (action === "allow_all") {
      const rawItems = Array.isArray(body?.items)
        ? body.items
        : [];

      const items = rawItems
        .map((item: any) => ({
          quizId: positiveInt(item?.quizId),
          studentId: positiveInt(item?.studentId),
        }))
        .filter(
          (
            item: {
              quizId: number | null;
              studentId: number | null;
            }
          ): item is {
            quizId: number;
            studentId: number;
          } =>
            Boolean(item.quizId) &&
            Boolean(item.studentId)
        );

      const uniqueItems = Array.from(
        new Map(
          items.map((item) => [
            `${item.quizId}__${item.studentId}`,
            item,
          ])
        ).values()
      );

      const allowedPairs: string[] = [];
      const alreadyAllowedPairs: string[] = [];
      const skippedUsedPairs: string[] = [];
      let failedCount = 0;

      for (const item of uniqueItems) {
        const key = `${item.quizId}__${item.studentId}`;

        const { data: existing, error: existingError } =
          await supabaseAdmin
            .from("quiz_reattempt_permissions")
            .select(
              "id,allowed,used_at,created_at"
            )
            .eq("quiz_id", item.quizId)
            .eq("student_id", item.studentId)
            .order("created_at", {
              ascending: false,
            })
            .limit(1)
            .maybeSingle();

        if (existingError) {
          failedCount += 1;
          continue;
        }

        if (
          existing &&
          existing.allowed === true &&
          !existing.used_at
        ) {
          alreadyAllowedPairs.push(key);
          continue;
        }

        if (existing) {
          const { error } = await supabaseAdmin
            .from("quiz_reattempt_permissions")
            .update({
              allowed: true,
              used_at: null,
            })
            .eq("id", existing.id);

          if (error) {
            failedCount += 1;
          } else {
            allowedPairs.push(key);
          }

          continue;
        }

        const { error } = await supabaseAdmin
          .from("quiz_reattempt_permissions")
          .insert({
            quiz_id: item.quizId,
            student_id: item.studentId,
            allowed: true,
            used_at: null,
          });

        if (error) {
          failedCount += 1;
        } else {
          allowedPairs.push(key);
        }
      }

      return NextResponse.json({
        success: true,
        allowedCount:
          allowedPairs.length +
          alreadyAllowedPairs.length,
        alreadyAllowedCount:
          alreadyAllowedPairs.length,
        skippedUsedCount: 0,
        failedCount,
        allowedPairs,
        alreadyAllowedPairs,
        skippedUsedPairs,
        processedCount: uniqueItems.length,
      });
    }

    if (action === "revoke") {
      const quizId = positiveInt(body?.quizId);
      const studentId = positiveInt(body?.studentId);

      if (!quizId || !studentId) {
        return NextResponse.json(
          {
            success: false,
            error: "Quiz ID and student ID are required.",
          },
          { status: 400 }
        );
      }

      const { data: existing, error: existingError } =
        await supabaseAdmin
          .from("quiz_reattempt_permissions")
          .select("id,allowed,used_at,created_at")
          .eq("quiz_id", quizId)
          .eq("student_id", studentId)
          .order("created_at", {
            ascending: false,
          })
          .limit(1)
          .maybeSingle();

      if (existingError) {
        return NextResponse.json(
          {
            success: false,
            error: existingError.message,
          },
          { status: 500 }
        );
      }

      if (!existing) {
        return NextResponse.json({
          success: true,
          revoked: false,
          message:
            "No active re-attempt permission was found.",
        });
      }

      if (existing.used_at) {
        return NextResponse.json(
          {
            success: false,
            error:
              "This re-attempt has already been used and cannot be revoked.",
          },
          { status: 409 }
        );
      }

      const { error: revokeError } =
        await supabaseAdmin
          .from("quiz_reattempt_permissions")
          .update({
            allowed: false,
          })
          .eq("id", existing.id);

      if (revokeError) {
        return NextResponse.json(
          {
            success: false,
            error: revokeError.message,
          },
          { status: 500 }
        );
      }

      return NextResponse.json({
        success: true,
        revoked: true,
      });
    }

    return NextResponse.json(
      {
        success: false,
        error: "Unsupported re-attempt action.",
      },
      { status: 400 }
    );
  } catch (error) {
    return NextResponse.json(
      {
        success: false,
        error:
          error instanceof Error
            ? error.message
            : "Unable to process re-attempt request.",
      },
      { status: 500 }
    );
  }
}
