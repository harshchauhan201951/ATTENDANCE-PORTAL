  top: auto !important;
  transform: none !important;
}
.racer-portal-content.racer-shared-teacher-module-content.racer-teacher-profile-route > main.profile-page.racer-module-page.racer-profile-page > .profile-shell {
  margin: 0 auto !important;
  padding-top: 0 !important;
  display: block !important;
