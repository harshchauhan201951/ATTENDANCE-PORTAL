/* RACER FEES MOBILE MOCKUP REVISION START */
@media (max-width: 640px) {
  .racer-vip-fees-page {
    width: 100% !important;
    max-width: 100vw !important;
    min-width: 0 !important;
    min-height: 100dvh !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden !important;
    background: #f2f7fd !important;
    box-sizing: border-box !important;
  }
  .racer-vip-fees-page .racer-vip-phone {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    min-height: 100dvh !important;
    margin: 0 !important;
    padding: 10px 10px calc(84px + env(safe-area-inset-bottom)) !important;
    background: #f4f8fe !important;
    box-shadow: none !important;
    overflow-x: hidden !important;
    box-sizing: border-box !important;
  }
  .racer-vip-fees-page .racer-vip-message {
    margin: 0 0 8px !important;
    padding: 9px 10px !important;
    border-radius: 10px !important;
    font-size: 11px !important;
    line-height: 1.35 !important;
    overflow-wrap: anywhere !important;
  }
  .racer-vip-fees-page .racer-vip-page-heading {
    display: grid !important;
    grid-template-columns: 34px minmax(0, 1fr) !important;
    gap: 7px !important;
    align-items: center !important;
    margin: 0 0 10px !important;
    padding: 8px 4px 10px !important;
    background: transparent !important;
    color: #102c58 !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }
  .racer-vip-fees-page .racer-vip-heading-icon {
    width: 32px !important;
    height: 32px !important;
    border-radius: 10px !important;
    background: #e0edff !important;
    color: #0759cf !important;
  }
  .racer-vip-fees-page .racer-vip-heading-copy h1 {
    margin: 0 !important;
    color: #102c58 !important;
    font-size: 18px !important;
    line-height: 1.15 !important;
    font-weight: 900 !important;
  }
  .racer-vip-fees-page .racer-vip-heading-copy p { display: none !important; }
  .racer-vip-fees-page .racer-vip-date-tile { display: none !important; }
  .racer-vip-fees-page .racer-vip-fee-summary {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 8px !important;
    margin: 0 0 10px !important;
    padding: 0 !important;
  }
  .racer-vip-fees-page .fee-summary-card {
    display: grid !important;
    grid-template-columns: 34px minmax(0, 1fr) !important;
    grid-template-rows: auto auto !important;
    align-items: center !important;
    column-gap: 8px !important;
    row-gap: 2px !important;
    min-width: 0 !important;
    min-height: 82px !important;
    margin: 0 !important;
    padding: 10px !important;
    border-radius: 13px !important;
    border: 1px solid #d9e7f8 !important;
    box-shadow: 0 3px 10px rgba(22, 63, 112, .06) !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
  }
  .racer-vip-fees-page .fee-summary-card > span {
    grid-column: 1 !important;
    grid-row: 1 / 3 !important;
    display: grid !important;
    place-items: center !important;
    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;
    border-radius: 9px !important;
    font-size: 16px !important;
    box-sizing: border-box !important;
  }
  .racer-vip-fees-page .fee-summary-card small {
    grid-column: 2 !important;
    grid-row: 1 !important;
    min-width: 0 !important;
    color: #526b8e !important;
    font-size: 10px !important;
    line-height: 1.2 !important;
    font-weight: 800 !important;
    overflow-wrap: anywhere !important;
  }
  .racer-vip-fees-page .fee-summary-card b {
    grid-column: 2 !important;
    grid-row: 2 !important;
    min-width: 0 !important;
    font-size: clamp(17px, 5vw, 23px) !important;
    line-height: 1.05 !important;
    overflow-wrap: anywhere !important;
    word-break: normal !important;
  }
  .racer-vip-fees-page .racer-vip-fee-entry {
