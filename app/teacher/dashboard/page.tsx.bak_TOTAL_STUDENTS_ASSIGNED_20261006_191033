    case "attendance":
      return <svg {...common}><path d="M5 12l4 4L19 6" /><path d="M5 5h7" /></svg>;
    case "history":
      return <svg {...common}><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /><path d="M12 7v5l3 2" /></svg>;
    case "calendar":
