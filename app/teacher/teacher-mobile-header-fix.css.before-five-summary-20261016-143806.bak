/* RACER DESKTOP DUPLICATE MODULE HEADERS FIX - desktop only */
@media (min-width: 1024px) {
  .racer-portal-content.racer-shared-teacher-module-content [data-racer-vip-header="1"],
  .racer-portal-content.racer-shared-teacher-module-content .racer-vip-header,
  .racer-portal-content.racer-shared-teacher-module-content .racer-vip-page-heading,
