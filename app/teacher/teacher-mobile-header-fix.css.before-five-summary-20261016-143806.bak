/* RACER ACADEMY mobile module header fix */
@media (max-width: 767px) {
:is(div, section, header):has(> .racer-vip-heading-copy):has(> .racer-vip-date-tile),
header[data-racer-vip-header="1"],
.page-header,
header:has(.racer-vip-brand-subtitle) {
  display: none !important;
}
}@media (max-width: 767px) {
  
  
}


/* RACER ACADEMY: distinctive, compact Teacher Settings layout for phones */
@media (max-width: 600px) {
  main.racer-settings-page {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    padding: 12px 10px calc(92px + env(safe-area-inset-bottom)) !important;
    overflow-x: hidden !important;
  }

  main.racer-settings-page > div {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 12px !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin: 0 auto !important;
    box-sizing: border-box !important;
  }

  main.racer-settings-page section {
    width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 14px !important;
    box-sizing: border-box !important;
    border: 1px solid #dce7fb !important;
    border-radius: 17px !important;
    background: #ffffff !important;
    box-shadow: 0 5px 18px rgba(30, 64, 175, 0.07) !important;
    overflow: hidden !important;
  }

  main.racer-settings-page section > div:first-child {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    min-width: 0 !important;
    margin-bottom: 12px !important;
  }

  main.racer-settings-page section > div:first-child > div:first-child {
    width: 40px !important;
    height: 40px !important;
    min-width: 40px !important;
    flex: 0 0 40px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border-radius: 12px !important;
    font-size: 20px !important;
  }

  main.racer-settings-page section h2 {
    margin: 0 !important;
    color: #172554 !important;
    font-size: 16px !important;
    line-height: 1.25 !important;
    font-weight: 750 !important;
    overflow-wrap: anywhere !important;
  }

  main.racer-settings-page section p {
    margin: 4px 0 0 !important;
    color: #64748b !important;
    font-size: 12px !important;
    line-height: 1.45 !important;
    overflow-wrap: anywhere !important;
  }

  /* Profile summary: two tidy identity tiles. */
  main.racer-settings-page section:nth-of-type(1) > div:nth-child(2) {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 9px !important;
  }

  main.racer-settings-page section:nth-of-type(1) > div:nth-child(2) > div {
    min-width: 0 !important;
    padding: 10px !important;
    border: 1px solid #e3ebfb !important;
    border-radius: 12px !important;
    background: #f7f9ff !important;
    overflow-wrap: anywhere !important;
  }

  /* Portal Settings: form fields stack cleanly and never overflow. */
  main.racer-settings-page section:nth-of-type(2) form > div:first-child {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 11px !important;
  }

  main.racer-settings-page label {
    display: block !important;
    margin: 0 0 5px !important;
    color: #334155 !important;
    font-size: 12px !important;
    font-weight: 650 !important;
    line-height: 1.35 !important;
  }

  main.racer-settings-page input,
  main.racer-settings-page select,
  main.racer-settings-page textarea {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    min-height: 44px !important;
    padding: 10px 11px !important;
    box-sizing: border-box !important;
    border-radius: 11px !important;
    font-size: 16px !important;
  }

  main.racer-settings-page section:nth-of-type(2) form > div:last-child {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 8px !important;
    margin-top: 13px !important;
  }

  /* Portal summary and shortcut tiles: consistent two-column grid. */
  main.racer-settings-page section:nth-of-type(3) > div:nth-child(2),
  main.racer-settings-page section:nth-of-type(4) > div:nth-child(2) {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 8px !important;
  }

  main.racer-settings-page section:nth-of-type(3) > div:nth-child(2) > div {
    min-width: 0 !important;
    padding: 10px !important;
    border: 1px solid #e3ebfb !important;
    border-radius: 12px !important;
    background: #f7f9ff !important;
    overflow-wrap: anywhere !important;
  }

  main.racer-settings-page section:nth-of-type(3) strong {
    display: block !important;
    font-size: 13px !important;
    line-height: 1.35 !important;
    overflow-wrap: anywhere !important;
  }

  main.racer-settings-page section:nth-of-type(4) > div:nth-child(2) button {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    min-width: 0 !important;
    min-height: 68px !important;
    width: 100% !important;
    padding: 10px 7px !important;
    border-radius: 12px !important;
    text-align: center !important;
    white-space: normal !important;
    overflow-wrap: anywhere !important;
    font-size: 12px !important;
    line-height: 1.3 !important;
    touch-action: manipulation !important;
  }

  main.racer-settings-page button {
    min-width: 0 !important;
    max-width: 100% !important;
    min-height: 42px !important;
    padding: 10px 9px !important;
    border-radius: 11px !important;
    white-space: normal !important;
    overflow-wrap: anywhere !important;
    font-size: 12px !important;
    line-height: 1.3 !important;
    touch-action: manipulation !important;
  }

  main.racer-settings-page section:nth-of-type(5) {
    display: flex !important;
    align-items: flex-start !important;
    gap: 10px !important;
    border-color: #f0d5d7 !important;
    background: #fffafb !important;
  }

  main.racer-settings-page section:nth-of-type(5) > div:nth-child(2) {
    flex: 1 1 auto !important;
    min-width: 0 !important;
  }

  main.racer-settings-page section:nth-of-type(5) button {
    width: 100% !important;
    margin-top: 9px !important;
  }

  main.racer-settings-page footer,
  main.racer-settings-page > div > div:last-child {
    max-width: 100% !important;
    min-width: 0 !important;
    overflow-wrap: anywhere !important;
    text-align: center !important;
    font-size: 11px !important;
  }
}
/* RACER SHARED MOBILE CONTENT OFFSET START */
@media (max-width: 767px) {
