  .racer-portal-content.racer-shared-teacher-module-content .topbar,
  .racer-portal-content.racer-shared-teacher-module-content .module-header,
  .racer-portal-content.racer-shared-teacher-module-content .module-page-header,
  .racer-portal-content.racer-shared-teacher-module-content .module-title-bar,
  .racer-portal-content.racer-shared-teacher-module-content .racer-module-header {
    display: none !important;
  }
}
