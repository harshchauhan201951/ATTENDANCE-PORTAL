  }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(2) {
    grid-column: 2 !important; grid-row: 1 !important;
    display: flex !important; flex-direction: column !important; gap: 2px !important;
    overflow: hidden !important; text-align: left !important;
  }
  .racer-vip-fees-page .fee-student strong {
    display: block !important; min-width: 0 !important;
    color: #153b6c !important; font-size: 12px !important; line-height: 1.2 !important;
    white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important;
  }
  .racer-vip-fees-page .fee-student small {
    display: block !important; min-width: 0 !important;
    color: #7185a0 !important; font-size: 9px !important; line-height: 1.2 !important;
    white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important;
  }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(3),
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(4),
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(5),
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(6) {
    grid-column: 2 !important;
    display: block !important;
    color: #35577f !important;
    font-size: 10px !important;
    line-height: 1.25 !important;
    text-align: left !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(3) { grid-row: 2 !important; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(3)::before { content: 'Class: '; font-weight: 900; color: #607997; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(4) { grid-row: 3 !important; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(4)::before { content: 'Fee: '; font-weight: 900; color: #607997; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(5) { grid-row: 4 !important; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(5)::before { content: 'Paid: '; font-weight: 900; color: #607997; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(6) { grid-row: 5 !important; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(6)::before { content: 'Due: '; font-weight: 900; color: #607997; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(7) {
    grid-column: 3 !important; grid-row: 1 !important;
    justify-self: end !important; align-self: start !important;
    white-space: nowrap !important; text-align: right !important;
  }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(7) > span {
    display: inline-flex !important; align-items: center !important; justify-content: center !important;
    max-width: 76px !important; min-height: 23px !important; padding: 4px 7px !important;
    border-radius: 999px !important; font-size: 9px !important; line-height: 1 !important;
    font-weight: 900 !important; white-space: nowrap !important;
  }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(8) {
    grid-column: 3 !important; grid-row: 2 / 6 !important;
    display: grid !important; grid-template-columns: repeat(2, 28px) !important;
    align-content: center !important; align-items: center !important; justify-content: end !important;
    gap: 5px !important; min-width: 0 !important;
  }
  .racer-vip-fees-page .fee-actions button {
    display: inline-flex !important; align-items: center !important; justify-content: center !important;
    width: 28px !important; min-width: 28px !important; height: 28px !important;
    padding: 0 !important; border-radius: 8px !important;
    box-sizing: border-box !important;
  }
  .racer-vip-fees-page .fee-actions button svg { width: 14px !important; height: 14px !important; }
  .racer-vip-fees-page .racer-vip-empty {
    padding: 24px 10px !important; color: #6b809c !important; font-size: 12px !important;
  }
  .racer-vip-fees-page .racer-vip-pagination {
    display: grid !important; grid-template-columns: 34px minmax(0, 1fr) 34px !important;
    align-items: center !important; gap: 6px !important;
    width: 100% !important; min-width: 0 !important; margin-top: 10px !important;
    padding-top: 9px !important; border-top: 1px solid #e4edf8 !important;
    box-sizing: border-box !important; overflow: hidden !important;
  }
  .racer-vip-fees-page .racer-vip-pagination span {
    min-width: 0 !important; color: #607b9f !important;
    font-size: 10px !important; text-align: center !important;
    white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important;
  }
  .racer-vip-fees-page .racer-vip-pagination button {
    width: 32px !important; min-width: 32px !important; height: 32px !important;
    border-radius: 8px !important; background: #edf4ff !important; color: #0759d6 !important;
  }
  .racer-vip-fees-page .racer-vip-bottom-nav {
    position: fixed !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
    z-index: 999 !important; min-height: 66px !important;
    padding: 0 8px env(safe-area-inset-bottom) !important;
    border-top: 1px solid #dce8f7 !important; background: rgba(255,255,255,.98) !important;
    box-shadow: 0 -4px 16px rgba(18, 52, 95, .08) !important;
  }
  .racer-vip-fees-page .racer-vip-bottom-nav > button {
    min-width: 0 !important; color: #31557f !important; font-size: 10px !important;
  }
  .racer-vip-fees-page .racer-vip-footer-brand strong { color: #0759d6 !important; font-size: 10px !important; }
  .racer-vip-fees-page .racer-vip-footer-brand small { color: #7185a0 !important; font-size: 7px !important; }
}
@media (max-width: 380px) {
  .racer-vip-fees-page .racer-vip-phone { padding-left: 7px !important; padding-right: 7px !important; }
  .racer-vip-fees-page .racer-vip-fee-history { padding: 8px !important; }
  .racer-vip-fees-page .fee-summary-card { padding: 8px !important; grid-template-columns: 29px minmax(0,1fr) !important; column-gap: 6px !important; }
  .racer-vip-fees-page .fee-summary-card > span { width: 28px !important; height: 28px !important; min-width: 28px !important; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) { grid-template-columns: 19px minmax(0,1fr) 66px !important; gap: 3px 5px !important; padding: 8px 5px !important; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(7) > span { max-width: 66px !important; padding: 4px 5px !important; font-size: 8px !important; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(8) { grid-template-columns: repeat(2,25px) !important; gap: 4px !important; }
  .racer-vip-fees-page .fee-actions button { width: 25px !important; min-width: 25px !important; height: 26px !important; }
  .racer-vip-fees-page .racer-fee-export-actions button { font-size: 9px !important; }
}
