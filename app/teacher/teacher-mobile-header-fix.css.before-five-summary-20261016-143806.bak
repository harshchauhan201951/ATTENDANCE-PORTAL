  }
  .racer-vip-fees-page .racer-vip-fee-grid.header { display: none !important; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) {
    display: grid !important;
    grid-template-columns: 23px minmax(0, 1fr) 76px !important;
    grid-template-rows: auto auto auto auto auto !important;
    align-items: center !important;
    gap: 3px 7px !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    min-height: 112px !important;
    margin: 0 !important;
    padding: 9px 7px !important;
    border: 1px solid #dce8f7 !important;
    border-radius: 11px !important;
    background: linear-gradient(180deg, #fff 0%, #fbfdff 100%) !important;
    box-shadow: 0 2px 7px rgba(21, 65, 118, .04) !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
  }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span { min-width: 0 !important; }
  .racer-vip-fees-page .racer-vip-fee-grid:not(.header) > span:nth-child(1) {
    grid-column: 1 !important; grid-row: 1 / 6 !important;
    align-self: start !important; padding-top: 2px !important;
